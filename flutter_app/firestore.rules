rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isParticipant(roomId) { return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)); }
    function isHost(roomId) { return isParticipant(roomId) && get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.isHost == true; }

    match /rooms/{roomId} {
      allow read: if isParticipant(roomId) || (signedIn() && resource.data.status == 'waiting');
      allow create: if signedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if isHost(roomId);
      match /participants/{participantId} {
        allow read: if isParticipant(roomId);
        allow create: if signedIn() && participantId == request.auth.uid && request.resource.data.roomId == roomId;
        allow update: if signedIn() && participantId == request.auth.uid;
        allow delete: if signedIn() && participantId == request.auth.uid;
      }
      match /rounds/{roundId} {
        allow read: if isParticipant(roomId);
        allow create, update: if isHost(roomId);
        match /answers/{answerId} {
          allow read: if isParticipant(roomId) && (get(/databases/$(database)/documents/rooms/$(roomId)/rounds/$(roundId)).data.status == 'revealing' || answerId == request.auth.uid);
          allow create, update: if signedIn() && answerId == request.auth.uid && isParticipant(roomId);
        }
      }
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminPath(uid) {
      return /databases/$(database)/documents/admins/$(uid);
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(adminPath(request.auth.uid))
        && get(adminPath(request.auth.uid)).data.active == true;
    }

    function validCategoryCreate() {
      return request.resource.data.keys().hasOnly(['name', 'active', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.active is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validCategoryUpdate() {
      return request.resource.data.keys().hasOnly(['name', 'active', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.active is bool
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function validQuestionCreate() {
      return request.resource.data.keys().hasOnly(['text', 'categoryId', 'recommendedAnswer', 'technique', 'source', 'active', 'createdAt', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.categoryId is string
        && exists(/databases/$(database)/documents/categories/$(request.resource.data.categoryId))
        && (!('recommendedAnswer' in request.resource.data) || (request.resource.data.recommendedAnswer is string && request.resource.data.recommendedAnswer.size() <= 1200))
        && (!('technique' in request.resource.data) || (request.resource.data.technique is string && request.resource.data.technique.size() <= 160))
        && (!('source' in request.resource.data) || (request.resource.data.source is string && request.resource.data.source.size() <= 160))
        && request.resource.data.active is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validQuestionUpdate() {
      return request.resource.data.keys().hasOnly(['text', 'categoryId', 'recommendedAnswer', 'technique', 'source', 'active', 'createdAt', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.categoryId is string
        && exists(/databases/$(database)/documents/categories/$(request.resource.data.categoryId))
        && (!('recommendedAnswer' in request.resource.data) || (request.resource.data.recommendedAnswer is string && request.resource.data.recommendedAnswer.size() <= 1200))
        && (!('technique' in request.resource.data) || (request.resource.data.technique is string && request.resource.data.technique.size() <= 160))
        && (!('source' in request.resource.data) || (request.resource.data.source is string && request.resource.data.source.size() <= 160))
        && request.resource.data.active is bool
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /admins/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'password');
      allow list, create, update, delete: if false;
    }

    match /categories/{categoryId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.active == true);
      allow create: if isAdmin() && validCategoryCreate();
      allow update: if isAdmin() && validCategoryUpdate();
      allow delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.active == true);
      allow create: if isAdmin() && validQuestionCreate();
      allow update: if isAdmin() && validQuestionUpdate();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
